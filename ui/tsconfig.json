{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": [
      "ES2023",
      "DOM",
      "DOM.Iterable"
    ],
    "types": [
      "svelte",
      "vite/client",
      "node"
    ],
    "strict": true,
    "noEmit": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "paths": {
      "$proto/*": [
        "../core/bindings/*"
      ]
    },
    "allowImportingTsExtensions": true
  },
  "include": [
    "src",
    "tests",
    "dev",
    "vite.config.ts"
  ]
}
